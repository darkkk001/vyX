PORT=8080
TRADING_CORE_URL=http://127.0.0.1:8081
DATABASE_URL=same value as the root app's DATABASE_URL
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
# Phase 1 trust pack §2 -- ADMIN_SESSION_SECRET (previously required here,
# fix/realtime-sync §1) is no longer needed: /v1/events/stream now reads
# the same Redis-backed admin_session:{token} key lib/auth.ts writes
# (see services/api-gateway/src/admin-auth.ts), not a JWT it had to
# verify with a shared secret. REDIS_URL above must point at the same
# Redis instance the root app uses -- that's the only thing that needs to
# match now.
