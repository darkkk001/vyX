PORT=8080
TRADING_CORE_URL=http://127.0.0.1:8081
DATABASE_URL=same value as the root app's DATABASE_URL
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
# fix/realtime-sync §1 -- must be the exact same value as the root app's
# ADMIN_SESSION_SECRET (lib/auth.ts). Verifies the vyx_admin_session JWT
# for /v1/events/stream connections; every admin-stream connection 401s
# without it. See services/api-gateway/src/admin-auth.ts.
ADMIN_SESSION_SECRET=same value as the root app's ADMIN_SESSION_SECRET
