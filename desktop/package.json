{
  "name": "vyxtrader-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native Windows wrapper around a broker's VyXTrader WebTrader — same app, rebranded per broker via broker.config.json + build/icon.ico.",
  "author": "BigFish Technologies LLC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bigfishtech.vyxtrader",
    "productName": "VyXTrader",
    "files": ["main.js", "preload.js", "broker.config.json"],
    "directories": { "output": "release" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
