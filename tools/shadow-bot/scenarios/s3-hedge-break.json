{
  "name": "s3-hedge-break",
  "title": "Hedge-break: a 50%-hedged vEUR pair sized from equity, one leg closed, margin back to full, then stop-out",
  "accounts": [
    "49990004"
  ],
  "symbols": [
    "vEUR"
  ],
  "steps": [
    {
      "op": "note",
      "text": "BUY sized so its FULL margin is 50% of equity (the first leg is checked at full margin, the hedge discount starts with the second leg). SELL = the same lots. Pair margin at 50% hedged = half of full (about 25% of equity); after the SELL closes the BUY is back at full (50%, margin level about 200%); stop-out 50% is then about a 3% move against the BUY."
    },
    {
      "op": "require",
      "account": "49990004",
      "minEquity": 150
    },
    {
      "op": "price.set",
      "symbol": "vEUR",
      "bid": 1.1,
      "spread": 0.0001
    },
    {
      "op": "hold",
      "secs": 3
    },
    {
      "op": "open",
      "account": "49990004",
      "symbol": "vEUR",
      "side": "BUY",
      "marginPctOfEquity": 50,
      "as": "buy"
    },
    {
      "op": "open",
      "account": "49990004",
      "symbol": "vEUR",
      "side": "SELL",
      "volumeOf": "buy",
      "as": "sell"
    },
    {
      "op": "observe",
      "account": "49990004"
    },
    {
      "op": "hold",
      "secs": 5,
      "expectOpen": [
        "buy",
        "sell"
      ]
    },
    {
      "op": "close",
      "ref": "sell"
    },
    {
      "op": "observe",
      "account": "49990004"
    },
    {
      "op": "hold",
      "secs": 5,
      "expectOpen": [
        "buy"
      ]
    },
    {
      "op": "rampUntil",
      "symbol": "vEUR",
      "direction": "down",
      "pctPerSec": 0.2,
      "maxPct": 5,
      "timeoutSecs": 120,
      "until": {
        "closed": [
          "buy"
        ]
      }
    },
    {
      "op": "expect",
      "stoppedOut": [
        "buy"
      ]
    }
  ]
}