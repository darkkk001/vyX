# Shell scripts must keep LF line endings regardless of the checkout
# platform's autocrlf setting -- a CRLF shebang line breaks `bash` on
# Linux ("bad interpreter"), which matters here since engine/scripts/*.sh
# is explicitly meant to run unchanged on a Linux VPS later.
*.sh text eol=lf

# Binary documents: never convert line endings (a PDF without NUL bytes gets detected as text).
*.pdf binary

# Prisma stores a checksum of each migration file: a CRLF checkout must never change those bytes.
prisma/migrations/** text eol=lf
# applied on live from a CRLF copy (checksum 8e6b4ec7...): keep these exact bytes so `migrate status` stays clean
prisma/migrations/20261103210000_vyx_open_position_idempotency/migration.sql -text
