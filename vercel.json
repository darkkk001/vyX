{
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand":"bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/internal/swap-rollover",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/internal/margin-monitor",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/equity-snapshots",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/risk-fallback",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/economic-events",
      "schedule": "20 */6 * * *"
    },
    {
      "path": "/api/internal/audit-retention",
      "schedule": "35 0 * * *"
    },
    {
      "path": "/api/internal/demo-cleanup",
      "schedule": "50 3 * * *"
    }
  ]
}
