DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Signing secret for admin session cookies (jose HS256). Generate with:
# openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-a-random-32-byte-secret"

# Root domain WebTrader broker subdomains hang off of, e.g. vyxtrader.com
# In local dev this is typically "localhost:3000".
ROOT_DOMAIN="localhost:3000"
