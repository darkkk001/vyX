FINNHUB_API_KEY=

# Test/QA database policy (vitest.setup.db-guard.ts, scripts/lib/db-host-policy.mjs):
# the production Neon endpoint is refused for tests no matter what; localhost is always allowed;
# any other host (your Neon DEV branch) must be listed here by endpoint id. Never set in Vercel.
TEST_DB_ALLOWED_HOSTS=
# Optional extra production hosts to refuse unconditionally (comma-separated endpoint ids)
PRODUCTION_DB_HOSTS=

# Cloudflare Turnstile for the Trader's Room sign-in and sign-up (Invisible widget). Unset = the check is off everywhere.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
