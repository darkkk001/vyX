// VyXTrader — Phase 1 data model
//
// Design notes (flagging assumptions since this file did not exist before):
// - "Account" is the trader's login (MT5-style): a client can have multiple
//   Accounts (DEMO + LIVE) under the same Broker. KYC is modeled per-Account
//   rather than introducing a separate Client entity, to match the model
//   list in the spec exactly. Revisit if brokers need one KYC record shared
//   across a client's demo+live accounts.
// - Order and Position are split (spec didn't list them, but the
//   "explicit state machine" and "idempotency on order placement" rules
//   require them from day one — Phase 2 wires the WebTrader UI to these).
// - AuditLog is added for the "every sensitive action needs an audit trail"
//   rule (balance adjustments, leverage changes, KYC approval, admin
//   permission changes, manual position closes).
// - All money/price/volume fields use Decimal — never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — used by the app at runtime
  directUrl = env("DIRECT_URL") // unpooled — used by Prisma Migrate
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum BrokerTier {
  STANDARD // $500/mo — logo only, default vyX theme, no CRM
  WHITE_LABEL // $800/mo — full branding + CRM/backoffice access
}

enum BrokerStatus {
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN // BigFish Technologies staff — brokerId is null
  BROKER_ADMIN // broker-scoped admin, full backoffice access
  SUPPORT // broker-scoped, restricted permissions
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum AccountType {
  DEMO
  LIVE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  CREDIT
  ADJUSTMENT // manual balance correction by an admin — always audited
  COMMISSION
  SWAP
  TRADE_PNL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum SymbolCategory {
  FOREX
  METALS
  INDICES
  CRYPTO
  COMMODITIES
  STOCKS
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

// PENDING -> ACCEPTED -> FILLED
//                     \-> REJECTED
// PENDING -> CANCELLED
enum OrderStatus {
  PENDING
  ACCEPTED
  FILLED
  REJECTED
  CANCELLED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum CommissionType {
  PER_LOT
  PERCENTAGE
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

model Broker {
  id           String       @id @default(cuid())
  name         String
  subdomain    String       @unique // brokername.vyxtrader.com
  customDomain String?      @unique // trade.brokername.com
  tier         BrokerTier   @default(STANDARD)
  status       BrokerStatus @default(ACTIVE)
  // Max open positions an account may hold at once, across all symbols.
  // Null = no limit — see docs/risk-engine.md §2.1 step 5.
  maxOpenPositionsPerAccount Int?

  // Branding — resolved at request time, never hardcoded or baked into a build.
  logoUrl      String?
  primaryColor String? // CSS custom property override, e.g. "#1e8a5f"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers      AdminUser[]
  accounts        Account[]
  transactions    Transaction[]
  brokerSymbols   BrokerSymbol[]
  ibRelationships IbRelationship[]
  orders          Order[]
  positions       Position[]
  auditLogs       AuditLog[]
}

model AdminUser {
  id           String      @id @default(cuid())
  brokerId     String? // null = super admin (BigFish Technologies staff)
  broker       Broker?     @relation(fields: [brokerId], references: [id])
  email        String      @unique
  passwordHash String
  role         AdminRole
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedKyc    KycRecord[]    @relation("KycReviewedBy")
  createdTxns    Transaction[]  @relation("TransactionCreatedBy")
  auditLogs      AuditLog[]     @relation("AuditLogActor")
  closedPosition Position[]     @relation("PositionClosedBy")

  @@index([brokerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Client accounts
// ─────────────────────────────────────────────────────────────────────────

model Account {
  id            String        @id @default(cuid())
  brokerId      String
  broker        Broker        @relation(fields: [brokerId], references: [id])
  accountNumber String        @unique // sequential login id shown to the trader
  email         String
  passwordHash  String
  fullName      String
  accountType   AccountType
  currency      String        @default("USD")
  leverage      Int           @default(100) // 1:100
  balance       Decimal       @default(0) @db.Decimal(18, 4)
  credit        Decimal       @default(0) @db.Decimal(18, 4) // non-withdrawable bonus
  status        AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kycRecord    KycRecord?
  transactions Transaction[]
  orders       Order[]
  positions    Position[]

  ibLinkAsIb     IbRelationship[] @relation("IbAccount")
  ibLinkAsClient IbRelationship?  @relation("ClientAccount")

  @@unique([brokerId, email, accountType])
  @@index([brokerId])
}

model KycRecord {
  id               String    @id @default(cuid())
  accountId        String    @unique
  account          Account   @relation(fields: [accountId], references: [id])
  status           KycStatus @default(PENDING)
  documentType     String // passport | national_id | drivers_license
  documentUrl      String
  addressProofUrl  String?
  rejectionReason  String?
  reviewedByAdminId String?
  reviewedByAdmin  AdminUser? @relation("KycReviewedBy", fields: [reviewedByAdminId], references: [id])
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Ledger — every balance-changing event goes through here. No silent
// balance overwrites; corrections are new rows, never edits/deletes.
// ─────────────────────────────────────────────────────────────────────────

model Transaction {
  id             String            @id @default(cuid())
  brokerId       String
  broker         Broker            @relation(fields: [brokerId], references: [id])
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id])
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         Decimal           @db.Decimal(18, 4) // signed: negative = debit
  balanceBefore  Decimal           @db.Decimal(18, 4)
  balanceAfter   Decimal           @db.Decimal(18, 4)
  referenceType  String? // "Position" | "Order" | null for manual/deposit/withdrawal
  referenceId    String?
  note           String?
  createdByAdminId String?
  createdByAdmin AdminUser?        @relation("TransactionCreatedBy", fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())

  @@index([brokerId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────
// Tradable instruments
// ─────────────────────────────────────────────────────────────────────────

model Symbol {
  id           String         @id @default(cuid())
  name         String         @unique // "EURUSD", "XAUUSD"
  baseCurrency String
  quoteCurrency String
  digits       Int            @default(5)
  contractSize Decimal        @default(100000) @db.Decimal(18, 4)
  category     SymbolCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brokerSymbols BrokerSymbol[]
  orders        Order[]
  positions     Position[]
}

/// Latest tick per symbol, pushed by an MT5 EA bridge (see
// app/api/internal/price-feed). Broker-agnostic raw market price — each
// broker's BrokerSymbol.spreadMarkup is applied on top when quoting a
// trader. Phase 5 replaces this source with a real LP FIX feed without
// touching anything downstream, since consumers only read bid/ask here.
model LivePrice {
  symbol    String   @id // matches Symbol.name, e.g. "EURUSD"
  bid       Decimal  @db.Decimal(18, 5)
  ask       Decimal  @db.Decimal(18, 5)
  updatedAt DateTime @updatedAt
}

enum CandleTimeframe {
  M1
  M5
  M30
  H1
  H4
  D1
  W1
  MN1
  Y1
}

/// Real OHLC history built from the same MT5 EA ticks that feed LivePrice,
/// aggregated at write time (see lib/price-feed.ts) so chart reads never
/// need to aggregate raw ticks. bucketStart is the timeframe-aligned window
/// start (e.g. H1 buckets to the top of the hour). Broker-agnostic, same as
/// LivePrice.
model Candle {
  symbol      String
  timeframe   CandleTimeframe
  bucketStart DateTime
  open        Decimal         @db.Decimal(18, 5)
  high        Decimal         @db.Decimal(18, 5)
  low         Decimal         @db.Decimal(18, 5)
  close       Decimal         @db.Decimal(18, 5)
  updatedAt   DateTime        @updatedAt

  @@id([symbol, timeframe, bucketStart])
  @@index([symbol, timeframe, bucketStart])
}

// Per-broker override: spread markup, swap, lot limits, enable/disable.
model BrokerSymbol {
  id           String  @id @default(cuid())
  brokerId     String
  broker       Broker  @relation(fields: [brokerId], references: [id])
  symbolId     String
  symbol       Symbol  @relation(fields: [symbolId], references: [id])
  spreadMarkup Decimal @default(0) @db.Decimal(10, 4) // pips added on top of raw spread
  minLot       Decimal @default(0.01) @db.Decimal(10, 2)
  maxLot       Decimal @default(100) @db.Decimal(10, 2)
  lotStep      Decimal @default(0.01) @db.Decimal(10, 2)
  swapLong     Decimal @default(0) @db.Decimal(10, 4)
  swapShort    Decimal @default(0) @db.Decimal(10, 4)
  enabled      Boolean @default(true)
  // Max total open volume (lots) an account may hold in this symbol at
  // once, summed across all its open positions. Null = no limit, so
  // existing brokers are unaffected until an admin sets one — see
  // docs/risk-engine.md §2.1 step 5.
  maxExposure  Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brokerId, symbolId])
  @@index([brokerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Orders & positions — explicit state machines, idempotent submission.
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  brokerId        String
  broker          Broker      @relation(fields: [brokerId], references: [id])
  accountId       String
  account         Account     @relation(fields: [accountId], references: [id])
  symbolId        String
  symbol          Symbol      @relation(fields: [symbolId], references: [id])
  side            OrderSide
  type            OrderType
  volume          Decimal     @db.Decimal(10, 2)
  requestedPrice  Decimal?    @db.Decimal(18, 5) // null for MARKET
  slPrice         Decimal?    @db.Decimal(18, 5)
  tpPrice         Decimal?    @db.Decimal(18, 5)
  status          OrderStatus @default(PENDING)
  filledPrice     Decimal?    @db.Decimal(18, 5)
  filledAt        DateTime?
  rejectionReason String?
  idempotencyKey  String // client-supplied, unique per account

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  position Position?

  @@unique([accountId, idempotencyKey])
  @@index([brokerId])
  @@index([accountId])
}

model Position {
  id            String         @id @default(cuid())
  brokerId      String
  broker        Broker         @relation(fields: [brokerId], references: [id])
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id])
  symbolId      String
  symbol        Symbol         @relation(fields: [symbolId], references: [id])
  originOrderId String         @unique
  originOrder   Order          @relation(fields: [originOrderId], references: [id])
  side          OrderSide
  volume        Decimal        @db.Decimal(10, 2)
  openPrice     Decimal        @db.Decimal(18, 5)
  slPrice       Decimal?       @db.Decimal(18, 5)
  tpPrice       Decimal?       @db.Decimal(18, 5)
  status        PositionStatus @default(OPEN)
  closePrice    Decimal?       @db.Decimal(18, 5)
  realizedPnl   Decimal?       @db.Decimal(18, 4)
  swap          Decimal        @default(0) @db.Decimal(18, 4)
  commission    Decimal        @default(0) @db.Decimal(18, 4)
  closedByAdminId String?
  closedByAdmin AdminUser?     @relation("PositionClosedBy", fields: [closedByAdminId], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime?

  @@index([brokerId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────
// Introducing brokers / affiliates
// ─────────────────────────────────────────────────────────────────────────

model IbRelationship {
  id              String         @id @default(cuid())
  brokerId        String
  broker          Broker         @relation(fields: [brokerId], references: [id])
  ibAccountId     String
  ibAccount       Account        @relation("IbAccount", fields: [ibAccountId], references: [id])
  clientAccountId String         @unique // each client is referred by exactly one IB
  clientAccount   Account        @relation("ClientAccount", fields: [clientAccountId], references: [id])
  commissionType  CommissionType
  commissionRate  Decimal        @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerId])
  @@index([ibAccountId])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit trail — who did it, when, old value, new value.
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id            String    @id @default(cuid())
  brokerId      String?
  broker        Broker?   @relation(fields: [brokerId], references: [id])
  actorAdminId  String?
  actorAdmin    AdminUser? @relation("AuditLogActor", fields: [actorAdminId], references: [id])
  action        String // "BALANCE_ADJUSTMENT" | "LEVERAGE_CHANGE" | "KYC_APPROVAL" | "ADMIN_PERMISSION_CHANGE" | "MANUAL_POSITION_CLOSE" | ...
  entityType    String // "Account" | "Position" | "AdminUser" | ...
  entityId      String
  oldValue      Json?
  newValue      Json?

  createdAt DateTime @default(now())

  @@index([brokerId])
  @@index([entityType, entityId])
}
