// VyXTrader — Phase 1 data model
//
// Design notes (flagging assumptions since this file did not exist before):
// - "Account" is the trader's login (MT5-style): a client can have multiple
//   Accounts (DEMO + LIVE) under the same Broker. KYC is modeled per-Account
//   rather than introducing a separate Client entity, to match the model
//   list in the spec exactly. Revisit if brokers need one KYC record shared
//   across a client's demo+live accounts.
// - Order and Position are split (spec didn't list them, but the
//   "explicit state machine" and "idempotency on order placement" rules
//   require them from day one — Phase 2 wires the WebTrader UI to these).
// - AuditLog is added for the "every sensitive action needs an audit trail"
//   rule (balance adjustments, leverage changes, KYC approval, admin
//   permission changes, manual position closes).
// - All money/price/volume fields use Decimal — never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — used by the app at runtime
  directUrl = env("DIRECT_URL") // unpooled — used by Prisma Migrate
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum BrokerTier {
  STANDARD // $500/mo — logo only, default vyX theme, no CRM
  WHITE_LABEL // $800/mo — full branding + CRM/backoffice access
}

enum BrokerStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  DISABLED
}

// See ADR-003 (docs/decisions.md) -- the broker-selection mechanism
// cutover needs. LEGACY = Next.js/Prisma trading path (every broker,
// today). RUST = the Rust trading-core engine. Setting this to RUST
// does NOT currently change any trading behavior -- no app/api/trade/*
// route reads this field yet, deliberately: ADR-003's own cutover gates
// (docs/testing.md §2 -- an automated test suite to compare against, a
// benchmark run) aren't met. This field exists so the selection
// mechanism is in place before those gates are, not so it does
// anything yet.
enum ExecutionEngine {
  LEGACY
  RUST
}

enum AdminRole {
  SUPER_ADMIN // VyXTechnologies staff — brokerId is null
  BROKER_ADMIN // broker-scoped admin, full backoffice access
  SUPPORT // broker-scoped, restricted permissions
  // Manager app (dealing desk) — broker-scoped, narrower than
  // BROKER_ADMIN (e.g. can edit symbol/spread config, not KYC/finance).
  // Always has a non-null brokerId (app-level rule, same as
  // BROKER_ADMIN/SUPPORT) — see docs/authentication.md §3.
  MANAGER
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum AccountType {
  DEMO
  LIVE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  CREDIT
  ADJUSTMENT // manual balance correction by an admin — always audited
  COMMISSION
  SWAP
  TRADE_PNL
  TRANSFER_OUT // internal transfer -- debit side, see app/api/manage/transfers
  TRANSFER_IN // internal transfer -- credit side
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum SymbolCategory {
  FOREX
  METALS
  INDICES
  CRYPTO
  COMMODITIES
  STOCKS
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

// PENDING -> ACCEPTED -> FILLED
//                     \-> REJECTED
// PENDING -> CANCELLED
// PENDING -> REQUOTED -> FILLED (client accepts the dealer's price)
//                     \-> CANCELLED (client rejects, or dealer withdraws)
enum OrderStatus {
  PENDING
  ACCEPTED
  FILLED
  REJECTED
  CANCELLED
  REQUOTED
}

enum BookType {
  A_BOOK
  B_BOOK
}

enum PositionStatus {
  OPEN
  CLOSED
  // Correcting an admin's own erroneous manual entry -- never a real
  // trade, no Transaction/balance ever moved for it. See
  // app/api/manage/positions/[id]/void/route.ts.
  VOIDED
}

enum CommissionType {
  PER_LOT
  PERCENTAGE
}

enum TradingMode {
  BOTH
  BUY_ONLY
  SELL_ONLY
}

// Controls which book a group's accounts' new positions default into,
// overriding BrokerSymbol.defaultBookType for any account with a group
// (see lib/dealing.ts's resolveBookType) -- LP = A_BOOK (real LP hedge,
// once one exists -- see LiquidityProvider's own schema comment),
// DEALING = B_BOOK (broker's own book, dealt internally), DEMO = B_BOOK
// too (paper trading, no real market exposure either way -- kept as its
// own value rather than reusing DEALING so a group's classification
// stays self-explanatory in the Manager UI, even though it resolves to
// the same book today). Ungrouped accounts are unaffected -- they keep
// reading the symbol's own defaultBookType exactly as before this field
// existed.
enum GroupType {
  LP
  DEALING
  DEMO
}

// Forward-compatible subset of the Auto Dealing design in
// REALTIME-SYNC-AND-DEALING-BRIEF §9 -- enum names kept consistent with it
// deliberately. Group.dealingMode overrides whether this group's MARKET
// orders reach the manual dealing queue, independent of GroupType's own
// book-routing classification -- see Group.dealingMode's own field
// comment for why those two needed to be decoupled (a group can be
// correctly B-book/DEALING-classified for accounting while still needing
// instant fills, e.g. a reverse-mirror master feeding strategy).
enum GroupDealingMode {
  INHERIT
  AUTO
  MANUAL
}

// Classification only -- a broker's own naming for an account-type tier
// (Standard/Pro/ECN/Zero are the common retail-broker convention). This
// field does NOT auto-generate or constrain pricing in any way; the
// actual spread markup/commission/swap values a broker sets per symbol
// for accounts in a tier live in GroupSymbolConfig below, entered
// manually per group. See Group.tier's own field comment for the full
// resolution story.
enum GroupTier {
  STANDARD
  PRO
  ECN
  ZERO
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

model Broker {
  id           String       @id @default(cuid())
  name         String
  subdomain    String       @unique // brokername.vyxtrader.com
  customDomain String?      @unique // trade.brokername.com
  tier         BrokerTier   @default(STANDARD)
  status       BrokerStatus @default(ACTIVE)
  // See ExecutionEngine's own doc comment -- currently decorative.
  executionEngine ExecutionEngine @default(LEGACY)
  // Max open positions an account may hold at once, across all symbols.
  // Null = no limit — see docs/risk-engine.md §2.1 step 5.
  maxOpenPositionsPerAccount Int?
  // Non-null = all new orders/positions across the broker are rejected
  // (existing open positions are untouched) -- see lib/risk.ts's
  // checkTradingHalted. The timestamp is itself the audit trail entry
  // point (when it was set); who set it lives in the paired AuditLog row.
  tradingHaltedAt DateTime? @db.Timestamptz(3)
  // Non-null = new MARKET orders from traders queue for a dealer
  // (MANAGER/BROKER_ADMIN) to manually Accept/Reject instead of
  // auto-filling -- see app/api/trade/orders/route.ts and
  // app/api/manage/dealing-queue/*. Same on/off-via-timestamp shape as
  // tradingHaltedAt, for the same reason (the timestamp is the audit
  // trail entry point; who set it lives in the paired AuditLog row).
  // LIMIT/STOP triggered fills are unaffected.
  dealingModeAt DateTime? @db.Timestamptz(3)
  // Null = fully manual dealing mode (today's behavior). When set,
  // a dealing-queue order auto-fills at the live price the moment it's
  // submitted if the requested price is within this % of live --
  // see app/api/trade/orders/route.ts's dealingModeAt branch.
  // Percentage rather than pips/absolute so one broker-wide setting
  // stays meaningful across symbols with very different price scales.
  smartDealerAcceptPct Decimal? @db.Decimal(6, 3)
  // Null = no auto-reject. Same submit-time check as
  // smartDealerAcceptPct -- if the requested price is this far (or
  // further) from live, the order is auto-REJECTED instead of queued.
  smartDealerRejectPct Decimal? @db.Decimal(6, 3)
  // Sum of open volume (lots) across every symbol for this broker. Null
  // = no limit -- see lib/risk.ts's checkBrokerExposure.
  totalExposureLimit Decimal? @db.Decimal(18, 2)

  // Applied by POST /api/manage/accounts when the admin doesn't specify
  // currency/leverage explicitly -- System Settings page.
  defaultAccountCurrency String @default("USD")
  defaultAccountLeverage Int    @default(100)

  // Branding — resolved at request time, never hardcoded or baked into a build.
  logoUrl      String?
  primaryColor String? // CSS custom property override, e.g. "#1e8a5f"
  // Shown in WebTrader's Help menu ("Contact support") instead of the
  // platform's own address -- a white-label promise means a broker's
  // trader emailing support reaches the broker, not us. Null = hide that
  // menu item rather than guess/leak an address that isn't theirs.
  supportEmail String?

  // Tenant lifecycle / billing — config-only, not wired to any real
  // payment processor (see lib/billing.ts's PLAN_PRICING). trialEndsAt is
  // set when status becomes TRIAL, cleared/ignored otherwise. nextInvoiceAt
  // is set when a broker moves to ACTIVE (Super Admin's Billing page), null
  // while TRIAL/SUSPENDED/DISABLED.
  trialEndsAt   DateTime? @db.Timestamptz(3)
  nextInvoiceAt DateTime? @db.Timestamptz(3)

  // Server-to-server credential for the WebTrader SSO handoff (see
  // lib/sso.ts): the broker's OWN external portal calls
  // POST /api/trade/sso/token with this secret in an X-Broker-Secret
  // header to prove it already authenticated the trader, and gets back a
  // short-lived one-time token to redirect the trader's browser to
  // /trade/sso with. Null = SSO not set up for this broker yet (the
  // token-issuance route rejects everything until Super Admin generates
  // one). Plaintext, not hashed -- same convention as PRICE_FEED_SECRET/
  // INTERNAL_SERVICE_SECRET (a machine credential, not a user password;
  // constant-shape comparison isn't attempted anywhere else in this
  // codebase for this class of secret either). Shown once at generation
  // time in Super Admin, never displayed again after.
  ssoSecret String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  adminUsers      AdminUser[]
  accounts        Account[]
  transactions    Transaction[]
  brokerSymbols   BrokerSymbol[]
  ibRelationships IbRelationship[]
  orders          Order[]
  positions       Position[]
  auditLogs       AuditLog[]
  groups          Group[]
  leads           Lead[]
  notifications   Notification[]
  liquidityProviders LiquidityProvider[]
  lpRoutingRules  LpRoutingRule[]
  mirrorRules     MirrorRule[]
}

model AdminUser {
  id           String      @id @default(cuid())
  brokerId     String? // null = super admin (VyXTechnologies staff)
  broker       Broker?     @relation(fields: [brokerId], references: [id])
  email        String      @unique
  passwordHash String
  role         AdminRole
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  // Extra BROKER_ADMIN-only capabilities delegated to a MANAGER-role
  // admin -- see lib/permissions.ts's PERMISSIONS list. Meaningless for
  // BROKER_ADMIN (already has everything implicitly) and SUPPORT (no
  // login route). Checked fresh from the DB on every request, not baked
  // into the session JWT -- see lib/permissions.ts's own comment for why.
  extraPermissions String[] @default([])

  // TOTP 2FA (RFC 6238) -- see lib/totp.ts, same scheme as Account's own
  // twoFactorSecret/Enabled (webtrader login). Exposed only on the Super
  // Admin login (app/api/admin/login) and its own settings page -- a
  // Broker Admin/Manager's backoffice login (app/api/manage/login) is a
  // separate route that never checks these fields.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  reviewedKyc    KycRecord[]    @relation("KycReviewedBy")
  createdTxns    Transaction[]  @relation("TransactionCreatedBy")
  reviewedTxns   Transaction[]  @relation("TransactionReviewedBy")
  markedTxns     Transaction[]  @relation("TransactionMarkedBy")
  auditLogs      AuditLog[]     @relation("AuditLogActor")
  closedPosition Position[]     @relation("PositionClosedBy")
  createdMirrorRules MirrorRule[]

  @@index([brokerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Client accounts
// ─────────────────────────────────────────────────────────────────────────

model Account {
  id            String        @id @default(cuid())
  brokerId      String
  broker        Broker        @relation(fields: [brokerId], references: [id])
  accountNumber String        @unique // sequential login id shown to the trader
  email         String
  passwordHash  String
  fullName      String
  accountType   AccountType
  currency      String        @default("USD")
  leverage      Int           @default(100) // 1:100
  balance       Decimal       @default(0) @db.Decimal(18, 4)
  credit        Decimal       @default(0) @db.Decimal(18, 4) // non-withdrawable bonus
  status        AccountStatus @default(ACTIVE)
  // Null = no limit. When set, new orders are rejected once today's
  // realized P&L (SUM of TRADE_PNL Transaction rows since local
  // midnight) is already at or below -maxDailyLoss -- see
  // lib/risk.ts's checkMaxDailyLoss. Existing open positions are
  // untouched; this only blocks new trading for the rest of the day.
  maxDailyLoss  Decimal?      @db.Decimal(18, 2)
  // Null = ungrouped (every account before this feature existed, and any
  // new one until an admin assigns it) -- see Group's own comment for
  // what assigning a group actually does today.
  groupId       String?
  group         Group?        @relation(fields: [groupId], references: [id])

  // Basic identity/KYC fields -- null for every account that existed
  // before this feature (there was previously no way to enter any of
  // this: no self-registration flow, only prisma/seed.ts). Set at
  // account-creation time via app/api/manage/accounts POST; not
  // (currently) editable afterward.
  country     String?
  phone       String?
  dateOfBirth DateTime? @db.Date

  // TOTP 2FA (RFC 6238) -- see lib/totp.ts. twoFactorSecret is set as soon
  // as setup starts (POST /api/trade/two-factor/setup) but
  // twoFactorEnabled stays false until the trader proves they scanned it
  // correctly (POST /api/trade/two-factor/confirm) -- this is deliberate:
  // a half-finished setup (secret generated, never confirmed) must never
  // gate login, only a confirmed one does. Plaintext base32, not hashed --
  // same reasoning as Broker.ssoSecret: verification needs the raw secret
  // to recompute the expected code, not just compare a hash.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  // Chart appearance/behavior prefs (candle colors, grid/last-price-line/
  // session-high-low/OHLC-bar visibility, timezone) -- server-side like
  // the watchlist, not localStorage, so web and desktop stay in sync. A
  // single JSON blob rather than a table: this is one fixed-shape
  // settings OBJECT per account, not a list of rows like WatchlistItem.
  // Null = trader has never saved custom settings yet, client applies its
  // own defaults (see lib/chart-settings.ts's DEFAULT_CHART_SETTINGS).
  chartSettings Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  kycRecord    KycRecord?
  transactions Transaction[]
  orders       Order[]
  positions    Position[]

  ibLinkAsIb     IbRelationship[] @relation("IbAccount")
  ibLinkAsClient IbRelationship?  @relation("ClientAccount")

  convertedFromLead Lead?

  // The account is the *target* (master) of a mirror rule -- see
  // MirrorRule's own doc comment. Named to be unambiguous from a future
  // "this account is a mirror *source*" relation (out of scope for v0,
  // sourceId there is unrelated/polymorphic, not a real FK).
  mirrorRuleTargets MirrorRule[] @relation("MirrorRuleTarget")

  watchlistItems WatchlistItem[]

  @@unique([brokerId, email, accountType])
  @@index([brokerId])
  @@index([groupId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// Prospective client, pre-Account -- CRM's "Leads" list. Conversion
// (app/manage/(shell)/leads/LeadsManager.tsx) doesn't duplicate account-
// creation logic: it calls the existing POST /api/manage/accounts
// directly, then PATCHes this row to CONVERTED with convertedAccountId.
model Lead {
  id       String     @id @default(cuid())
  brokerId String
  broker   Broker     @relation(fields: [brokerId], references: [id])
  fullName String
  email    String
  phone    String?
  country  String?
  source   String? // free text ("Website", "Referral", ...) -- no fixed taxonomy given
  status   LeadStatus @default(NEW)
  notes    String?

  convertedAccountId String?  @unique
  convertedAccount   Account? @relation(fields: [convertedAccountId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([brokerId])
}

// Settings template accounts can be assigned to (per-broker). Deliberately
// NOT yet read by the Rust engine's margin/order path -- see
// docs/risk-engine.md's implementation-status note. Assigning an account
// to a group copies `leverage` onto Account.leverage once, at assignment
// time (see app/api/manage/accounts/[id]/route.ts) -- Account.leverage
// stays the one value every trading code path already reads;
// marginCallLevel/stopOutLevel are stored/displayed only for now.
model Group {
  id              String  @id @default(cuid())
  brokerId        String
  broker          Broker  @relation(fields: [brokerId], references: [id])
  name            String
  leverage        Int     @default(100)
  marginCallLevel Decimal @default(100) @db.Decimal(6, 2)
  stopOutLevel    Decimal @default(50) @db.Decimal(6, 2)
  isDefault       Boolean @default(false)
  // Null = no override, falls through to the existing per-symbol
  // minLot/maxLot check unchanged -- see lib/risk.ts's checkGroupMaxLot.
  maxLotSize      Decimal? @db.Decimal(10, 2)
  // Same enum/semantics as BrokerSymbol.tradingMode -- see
  // lib/risk.ts's checkGroupTradingRestriction.
  tradingRestriction TradingMode @default(BOTH)
  // Config-only -- no live Next.js path charges swap at all yet (that
  // only exists in the Rust engine's daily rollover job, which nothing
  // live is cut over to), so there's nothing to skip for a swap-free
  // group today. Recorded now so it's ready once that changes.
  swapFree        Boolean @default(false)
  // Opt-in symbol allowlist -- false (default) means every enabled
  // BrokerSymbol is tradable by this group, identical to every group's
  // behavior before this field existed (zero change for existing
  // groups/accounts). true restricts trading to only the symbols with a
  // GroupSymbol row below -- see lib/risk.ts's checkGroupAllowedSymbol.
  restrictSymbols Boolean @default(false)
  // Independent of Broker.dealingModeAt -- either one alone is enough to
  // route a MARKET order from an account in this group to the dealing
  // queue instead of auto-filling. false (default) = zero change for
  // every existing group; this only ever ADDS accounts to dealing
  // review, never removes them from the broker-wide setting. See
  // app/api/trade/orders/route.ts's dealing-mode branch.
  forceDealingMode Boolean @default(false)
  // See GroupType's own doc comment -- book routing for this group's
  // accounts. Defaults to DEALING (B_BOOK), the same book every account
  // already fills into today via BrokerSymbol.defaultBookType's own
  // default -- zero behavior change for existing groups until a broker
  // deliberately sets one to LP or DEMO.
  groupType GroupType @default(DEALING)
  // Overrides whether this group's MARKET orders reach the manual dealing
  // queue -- independent of groupType, forceDealingMode, and
  // Broker.dealingModeAt, all three of which stay meaningful for every
  // group that doesn't set this. INHERIT (default) = zero behavior
  // change, the existing three-way check decides exactly as before. AUTO
  // = always auto-fill for this group (still subject to the margin gate
  // and server price -- never a raw bypass of trade validity), regardless
  // of any broker/group-level manual-review setting -- for a group whose
  // whole strategy depends on instant fills (e.g. a reverse-mirror
  // source group) but is still correctly groupType=DEALING for book
  // accounting. MANUAL = always queue for this group, even if nothing
  // else would have. See app/api/trade/orders/route.ts's routing check
  // and docs/mirror.md.
  dealingMode GroupDealingMode @default(INHERIT)
  // See GroupTier's own doc comment -- classification only, doesn't
  // affect pricing by itself. Defaults to STANDARD, same "config now"
  // zero-change-for-existing-groups convention as groupType above.
  tier      GroupTier @default(STANDARD)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts Account[]
  allowedSymbols GroupSymbol[]
  symbolConfigs  GroupSymbolConfig[]

  @@unique([brokerId, name])
  @@index([brokerId])
}

// Per-group override of one symbol's pricing, entered manually by a
// broker in the Manager UI (e.g. "my ECN-tier group pays less spread but
// more commission than my Standard-tier group"). Absence of a row for a
// (groupId, symbolId) pair means "use BrokerSymbol's broker-wide value
// instead" -- same "missing config = defaults" convention BrokerSymbol
// itself already uses against Symbol (see BrokerSymbol's own comment).
// Resolved at every real order-fill site (see lib/group-pricing.ts's
// resolveSymbolPricing) -- unlike BrokerSymbol.spreadMarkup/
// commissionPerLot, which sit unread by the live Next.js trading path
// (only the not-yet-cut-over Rust engine reads those), this table's
// values ARE applied to real fills the moment a broker sets them, for
// any account whose group has a row here.
model GroupSymbolConfig {
  id               String  @id @default(cuid())
  groupId          String
  group            Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  symbolId         String
  symbol           Symbol  @relation(fields: [symbolId], references: [id])
  spreadMarkup     Decimal @default(0) @db.Decimal(10, 4) // pips added on top of raw spread, same convention as BrokerSymbol.spreadMarkup
  commissionPerLot Decimal @default(0) @db.Decimal(10, 2) // flat fee per lot, charged once when a position opens
  swapLong         Decimal @default(0) @db.Decimal(10, 4)
  swapShort        Decimal @default(0) @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupId, symbolId])
  @@index([groupId])
}

// One row = this symbol is explicitly allowed for this group. Only
// consulted when Group.restrictSymbols is true -- otherwise every
// enabled BrokerSymbol is tradable regardless of what's (or isn't)
// listed here, so a broker can freely toggle restrictSymbols on/off
// without losing whatever allowlist they'd already built up.
model GroupSymbol {
  id       String @id @default(cuid())
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  symbolId String
  symbol   Symbol @relation(fields: [symbolId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([groupId, symbolId])
  @@index([groupId])
}

model KycRecord {
  id               String    @id @default(cuid())
  accountId        String    @unique
  account          Account   @relation(fields: [accountId], references: [id])
  status           KycStatus @default(PENDING)
  documentType     String // passport | national_id | drivers_license
  documentFrontUrl String
  documentBackUrl  String?
  addressProofUrl  String?
  rejectionReason  String?
  reviewedByAdminId String?
  reviewedByAdmin  AdminUser? @relation("KycReviewedBy", fields: [reviewedByAdminId], references: [id])
  reviewedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ─────────────────────────────────────────────────────────────────────────
// Ledger — every balance-changing event goes through here. No silent
// balance overwrites; corrections are new rows, never edits/deletes.
// ─────────────────────────────────────────────────────────────────────────

model Transaction {
  id             String            @id @default(cuid())
  brokerId       String
  broker         Broker            @relation(fields: [brokerId], references: [id])
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id])
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         Decimal           @db.Decimal(18, 4) // signed: negative = debit
  balanceBefore  Decimal           @db.Decimal(18, 4)
  balanceAfter   Decimal           @db.Decimal(18, 4)
  referenceType  String? // "Position" | "Order" | null for manual/deposit/withdrawal
  referenceId    String?
  note           String?
  createdByAdminId String?
  createdByAdmin AdminUser?        @relation("TransactionCreatedBy", fields: [createdByAdminId], references: [id])
  // Who approved/rejected a PENDING request (deposit/withdrawal) --
  // mirrors KycRecord.reviewedByAdminId's existing pattern. Null for
  // rows that never went through a review step (e.g. TRADE_PNL,
  // ADJUSTMENT, both created directly as COMPLETED).
  reviewedByAdminId String?
  reviewedByAdmin AdminUser?        @relation("TransactionReviewedBy", fields: [reviewedByAdminId], references: [id])
  // Maker-checker for WITHDRAWAL requests only (deposits stay single-
  // approval) -- see app/api/manage/funds-requests/[id]/route.ts. Set on
  // the first APPROVE (status stays PENDING); a second APPROVE by a
  // *different* admin is what actually completes it. Null throughout for
  // every other Transaction type/flow.
  markedByAdminId String?
  markedByAdmin   AdminUser? @relation("TransactionMarkedBy", fields: [markedByAdminId], references: [id])
  markedAt        DateTime?  @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  // First Transaction field to change after creation -- a PENDING
  // deposit/withdrawal request transitions to COMPLETED/REJECTED on
  // review (see app/api/manage/funds-requests/[id]/route.ts). Every
  // other Transaction type is still created once, already COMPLETED,
  // and never touched again.
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([brokerId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────
// Tradable instruments
// ─────────────────────────────────────────────────────────────────────────

model Symbol {
  id           String         @id @default(cuid())
  name         String         @unique // "EURUSD", "XAUUSD"
  baseCurrency String
  quoteCurrency String
  digits       Int            @default(5)
  contractSize Decimal        @default(100000) @db.Decimal(18, 4)
  category     SymbolCategory

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  brokerSymbols BrokerSymbol[]
  orders        Order[]
  positions     Position[]
  lpRoutingRules LpRoutingRule[]
  groupAllowlists GroupSymbol[]
  groupSymbolConfigs GroupSymbolConfig[]
  watchlistItems WatchlistItem[]
}

// Per-account watchlist, server-side (not localStorage) so web and desktop
// stay in sync -- see the terminal's own watchlist feature. A row's mere
// existence means "visible in this account's watchlist"; hiding a symbol
// deletes its row rather than flagging it, and "reset to default" is just
// "delete every row for this account" (the next GET reseeds the default
// set, same as a brand new account) -- no separate hidden/visible flag to
// keep in sync. `position` is a plain sort index, rewritten wholesale on
// every reorder (small N, no need for a fractional-index scheme).
model WatchlistItem {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  symbolId  String
  symbol    Symbol   @relation(fields: [symbolId], references: [id])
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([accountId, symbolId])
  @@index([accountId])
}

/// Latest tick per symbol, pushed by an MT5 EA bridge (see
// app/api/internal/price-feed). Broker-agnostic raw market price — each
// broker's BrokerSymbol.spreadMarkup is applied on top when quoting a
// trader. Phase 5 replaces this source with a real LP FIX feed without
// touching anything downstream, since consumers only read bid/ask here.
model LivePrice {
  symbol    String   @id // matches Symbol.name, e.g. "EURUSD"
  bid       Decimal  @db.Decimal(18, 5)
  ask       Decimal  @db.Decimal(18, 5)
  // Row-write time -- bumped on every flush regardless of whether bid/ask
  // actually changed (the sole writer, engine/market-data's
  // upsert_live_prices_batch, always sets this to now()). Ordinary
  // bookkeeping only now -- NOT the staleness signal (see tickAt below).
  // Kept for whatever still wants "when was this row last touched"
  // (nothing does today, but no reason to remove a harmless column).
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  // The REAL last-tick time -- the MT5 EA's own SymbolInfoTick time_msc
  // (corrected to UTC), carried through unchanged on a heartbeat resend
  // of an unchanged price. This is what actually stops advancing when the
  // underlying market genuinely goes quiet (a real market close, or a
  // mid-week feed outage), unlike updatedAt above -- see
  // lib/risk.ts's checkPriceFreshness, which reads this column, not
  // updatedAt, for exactly that reason (a real incident: a MARKET order
  // filled XAUUSD on a Saturday because updatedAt alone couldn't tell a
  // frozen weekend price apart from a live one being heartbeat-resent).
  // Defaults to now() only so the migration's ADD COLUMN has something to
  // backfill existing rows with -- every real write from that point on
  // sets it explicitly (see engine/market-data/src/ingest.rs's
  // resolve_tick_time).
  tickAt DateTime @default(now()) @db.Timestamptz(3)
}

enum CandleTimeframe {
  M1
  M5
  M30
  H1
  H4
  D1
  W1
  MN1
  Y1
}

/// Real OHLC history built from the same MT5 EA ticks that feed LivePrice,
/// aggregated at write time (see lib/price-feed.ts) so chart reads never
/// need to aggregate raw ticks. bucketStart is the timeframe-aligned window
/// start (e.g. H1 buckets to the top of the hour). Broker-agnostic, same as
/// LivePrice.
model Candle {
  symbol      String
  timeframe   CandleTimeframe
  bucketStart DateTime        @db.Timestamptz(3)
  open        Decimal         @db.Decimal(18, 5)
  high        Decimal         @db.Decimal(18, 5)
  low         Decimal         @db.Decimal(18, 5)
  close       Decimal         @db.Decimal(18, 5)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@id([symbol, timeframe, bucketStart])
  // The old @@index([symbol, timeframe, bucketStart]) here duplicated
  // this @@id's own index exactly (same columns, same order) -- every
  // write maintained two identical btree indexes for nothing, since
  // Postgres already uses a unique index for plain lookups/range scans
  // just as well as a non-unique one. Dropped in migration
  // 20260831060000_drop_redundant_candle_index. This one instead backs
  // the nightly retention job's own WHERE clause (engine's
  // retention::spawn_candle_retention -- filters by timeframe +
  // bucketStart without symbol, which @@id can't serve as an index scan
  // since it leads with symbol).
  @@index([timeframe, bucketStart])
}

// Per-broker override: spread markup, swap, lot limits, enable/disable.
model BrokerSymbol {
  id           String  @id @default(cuid())
  brokerId     String
  broker       Broker  @relation(fields: [brokerId], references: [id])
  symbolId     String
  symbol       Symbol  @relation(fields: [symbolId], references: [id])
  spreadMarkup Decimal @default(0) @db.Decimal(10, 4) // pips added on top of raw spread
  minLot       Decimal @default(0.01) @db.Decimal(10, 2)
  maxLot       Decimal @default(100) @db.Decimal(10, 2)
  lotStep      Decimal @default(0.01) @db.Decimal(10, 2)
  // Account-currency amount per standard lot per day held overnight —
  // not points/pips, to avoid needing per-symbol pip-size math the way
  // spreadMarkup does. Negative = cost to the trader, positive = credit.
  // Applied by the daily rollover job (order_management::swap) — see
  // docs/risk-engine.md and execution.md's commission/swap sections.
  swapLong     Decimal @default(0) @db.Decimal(10, 4)
  swapShort    Decimal @default(0) @db.Decimal(10, 4)
  enabled      Boolean @default(true)
  // BOTH (default) / BUY_ONLY / SELL_ONLY -- rejects orders on the
  // disallowed side even when the symbol is otherwise enabled. See
  // lib/risk.ts's checkSymbolTradingMode.
  tradingMode  TradingMode @default(BOTH)
  // Flat fee per lot, charged once when a position opens (round-turn,
  // not split between open/close). Null-safe default of 0 means existing
  // brokers charge no commission until an admin sets a rate.
  commissionPerLot Decimal @default(0) @db.Decimal(10, 2)
  // Max total open volume (lots) an account may hold in this symbol at
  // once, summed across all its open positions. Null = no limit, so
  // existing brokers are unaffected until an admin sets one — see
  // docs/risk-engine.md §2.1 step 5.
  maxExposure  Decimal? @db.Decimal(18, 2)
  // Stamped onto every new Position opened in this symbol -- config/
  // record-keeping only, no real hedge execution against an LP happens
  // (that's still blocked on a real LP relationship, same as
  // LiquidityProvider). See lib/dealing.ts's openPositionFromOrder.
  defaultBookType BookType @default(B_BOOK)
  // Minimum distance, in POINTS (the symbol's own smallest price
  // increment -- 10^-digits), an SL/TP or a pending order's own entry
  // price must sit away from the current market price -- the standard
  // MT4/5 "stop level" concept, which this schema never had before the
  // chart's own draggable SL/TP feature needed something to validate a
  // drag against. 0 = no restriction (every existing symbol's behavior
  // is unchanged until a broker admin sets a real value). See
  // lib/trading.ts's validateSlTp.
  stopLevel Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tradingSessions TradingSession[]

  @@unique([brokerId, symbolId])
  @@index([brokerId])
}

// Allowed trading windows for a symbol. Zero rows for a BrokerSymbol =
// always tradable (same null/empty-means-unlimited convention as
// maxExposure/maxDailyLoss elsewhere in this schema) -- adding this
// model doesn't restrict any existing symbol until an admin explicitly
// adds session rows. See lib/risk.ts's checkTradingSession.
model TradingSession {
  id             String       @id @default(cuid())
  brokerSymbolId String
  brokerSymbol   BrokerSymbol @relation(fields: [brokerSymbolId], references: [id])
  dayOfWeek      Int // 0 = Sunday .. 6 = Saturday (UTC)
  openTime       String // "HH:MM", UTC
  closeTime      String // "HH:MM", UTC

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([brokerSymbolId])
}

// ─────────────────────────────────────────────────────────────────────────
// Orders & positions — explicit state machines, idempotent submission.
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  brokerId        String
  broker          Broker      @relation(fields: [brokerId], references: [id])
  accountId       String
  account         Account     @relation(fields: [accountId], references: [id])
  symbolId        String
  symbol          Symbol      @relation(fields: [symbolId], references: [id])
  side            OrderSide
  type            OrderType
  volume          Decimal     @db.Decimal(10, 2)
  requestedPrice  Decimal?    @db.Decimal(18, 5) // null for MARKET
  slPrice         Decimal?    @db.Decimal(18, 5)
  tpPrice         Decimal?    @db.Decimal(18, 5)
  status          OrderStatus @default(PENDING)
  filledPrice     Decimal?    @db.Decimal(18, 5)
  filledAt        DateTime? @db.Timestamptz(3)
  rejectionReason String?
  // Set when a dealer accepts this order at a price that differs from
  // the live price at accept time (a deliberate reprice, not ordinary
  // slippage) -- see app/api/manage/dealing-queue/[id]/route.ts. The
  // order sits at status REQUOTED until the client responds via
  // app/api/trade/orders/[id]/requote-response.
  requotedPrice   Decimal?    @db.Decimal(18, 5)
  idempotencyKey  String // client-supplied, unique per account

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  position Position?

  @@unique([accountId, idempotencyKey])
  @@index([brokerId])
  @@index([accountId])
}

model Position {
  id            String         @id @default(cuid())
  brokerId      String
  broker        Broker         @relation(fields: [brokerId], references: [id])
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id])
  symbolId      String
  symbol        Symbol         @relation(fields: [symbolId], references: [id])
  originOrderId String         @unique
  originOrder   Order          @relation(fields: [originOrderId], references: [id])
  side          OrderSide
  volume        Decimal        @db.Decimal(10, 2)
  openPrice     Decimal        @db.Decimal(18, 5)
  slPrice       Decimal?       @db.Decimal(18, 5)
  tpPrice       Decimal?       @db.Decimal(18, 5)
  status        PositionStatus @default(OPEN)
  closePrice    Decimal?       @db.Decimal(18, 5)
  realizedPnl   Decimal?       @db.Decimal(18, 4)
  swap          Decimal        @default(0) @db.Decimal(18, 4)
  commission    Decimal        @default(0) @db.Decimal(18, 4)
  // Stamped from BrokerSymbol.defaultBookType at fill time -- record-
  // keeping only, see that field's schema comment.
  bookType      BookType       @default(B_BOOK)
  closedByAdminId String?
  closedByAdmin AdminUser?     @relation("PositionClosedBy", fields: [closedByAdminId], references: [id])

  openedAt DateTime  @default(now()) @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)

  @@index([brokerId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────
// Reverse mirror (docs/briefs/VYX-MIRROR-V0-BRIEF.md) — v0 hooks the
// legacy order-fill/position-close paths directly (lib/mirror.ts's
// onFill/onClose). This schema is the permanent shape: Phase 3 only
// rewires the hook to engine fill-events, so nothing here should need to
// change when that happens — see docs/mirror.md.
// ─────────────────────────────────────────────────────────────────────────

enum MirrorSource {
  GROUP
  ACCOUNT
}

enum MirrorDirection {
  REVERSE
  SAME
}

// The mirrored fill/close price basis. SOURCE_PRICE (default) copies the
// source position's own fill/close price exactly, no live-price lookup
// and no spread markup applied on the mirror's own leg -- correct for
// today's only real target shape, an internal broker ledger account: the
// client's own trade already crossed the spread once (client BUY @ ask,
// e.g. 4377.78), so a mirrored SELL that ALSO fills at live bid (say
// 4377.66) charges that same spread a second time, on both open and
// close, purely as an artifact of using live bid/ask for a leg that was
// never a real, separate market execution. MARKET keeps the original
// (pre-fix) behavior -- fills at live bid/ask with the normal spread
// markup applied, same as any other fill in this app -- reserved for a
// future external-style target (a real hedge account at an actual LP)
// where the mirror leg genuinely is a separate market execution and
// should be priced as one.
enum MirrorFillPriceMode {
  SOURCE_PRICE
  MARKET
}

// One rule = "mirror trades from this group/account onto this target
// account." sourceId is intentionally NOT a foreign key -- it points at
// either Group.id or Account.id depending on sourceType, the same
// "polymorphic reference, resolved by the app layer" shape AuditLog.
// entityId/Notification.entityId already use in this schema, rather than
// two nullable FK columns with a check constraint. targetAccountId IS a
// real FK (there's exactly one target, always an Account) with RESTRICT,
// matching every other required Account reference in this schema (Account
// rows are never hard-deleted).
model MirrorRule {
  id       String @id @default(cuid())
  brokerId String
  broker   Broker @relation(fields: [brokerId], references: [id])

  sourceType MirrorSource
  sourceId   String // Group.id or Account.id, per sourceType -- see above

  targetAccountId String
  targetAccount   Account @relation("MirrorRuleTarget", fields: [targetAccountId], references: [id])

  direction  MirrorDirection @default(REVERSE)
  multiplier Decimal         @default(1) @db.Decimal(10, 4) // lot scale, e.g. 0.5 = half size
  // See MirrorFillPriceMode's own doc comment. Defaults to SOURCE_PRICE --
  // every rule created before this field existed is backfilled to it too
  // (the column default), which is the *correct* retroactive behavior for
  // an internal ledger target, not just a safe migration default.
  fillPriceMode MirrorFillPriceMode @default(SOURCE_PRICE)
  // CSV of Symbol.name, e.g. "XAUUSD,EURUSD" -- null = every symbol the
  // source trades is mirrored. Free-text CSV (not a join table) matches
  // this schema's existing BrokerSymbol.symbolMap-style free-text
  // conventions for a v0-scoped allowlist; a join table is the natural
  // upgrade if per-symbol config (not just inclusion) is ever needed.
  symbolFilter String?

  // Both null = no cap (v0 default -- a broker must opt into limits
  // deliberately, same "null = unlimited" convention as Group.maxLotSize/
  // Broker.totalExposureLimit elsewhere in this schema).
  maxOpenLots  Decimal? @db.Decimal(10, 2) // sum of this rule's own open target-side lots
  maxDailyLoss Decimal? @db.Decimal(18, 2) // target account's realized-today + floating P/L

  enabled Boolean @default(true)
  // Set the instant a cap breaches (lib/mirror.ts's checkKillSwitch) --
  // the timestamp IS the audit trail entry point, same shape as
  // Broker.tradingHaltedAt/dealingModeAt. enabled is also flipped false at
  // the same time so every other read site only ever needs to check
  // `enabled`, not `enabled && !killedAt`.
  killedAt DateTime?

  // Count-only, not a log -- the real detail lives in AuditLog rows
  // (action: "MIRROR_FAILED", entityType: "MirrorRule"). Surfaced in the
  // rules table so a broker admin sees "3 failures" without opening the
  // audit log, and can decide whether a rule needs attention.
  failureCount Int @default(0)

  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  links MirrorLink[]

  @@index([brokerId])
  @@index([sourceType, sourceId])
  @@index([targetAccountId])
}

// Audit trail AND the live source-position -> target-position map lib/
// mirror.ts's onClose needs to find what to close. sourcePositionId is
// unique -- one source position mirrors to at most one target position,
// which is also what makes onFill idempotent (a retried/duplicate onFill
// call for the same source position hits this unique constraint instead
// of opening a second mirror).
model MirrorLink {
  id     String     @id @default(cuid())
  ruleId String
  rule   MirrorRule @relation(fields: [ruleId], references: [id])

  sourcePositionId String   @unique
  targetPositionId String   @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([ruleId])
}

// ─────────────────────────────────────────────────────────────────────────
// Introducing brokers / affiliates
// ─────────────────────────────────────────────────────────────────────────

model IbRelationship {
  id              String         @id @default(cuid())
  brokerId        String
  broker          Broker         @relation(fields: [brokerId], references: [id])
  ibAccountId     String
  ibAccount       Account        @relation("IbAccount", fields: [ibAccountId], references: [id])
  clientAccountId String         @unique // each client is referred by exactly one IB
  clientAccount   Account        @relation("ClientAccount", fields: [clientAccountId], references: [id])
  commissionType  CommissionType
  commissionRate  Decimal        @db.Decimal(10, 4)
  // Null = never paid -- pending commission is computed on read from
  // CLOSED Positions on clientAccountId with closedAt after this (or
  // all-time if null), not stored/accrued anywhere. Set to now() each
  // time a payout is made (app/api/manage/ib-relationships/[id]/route.ts).
  lastPayoutAt    DateTime?      @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([brokerId])
  @@index([ibAccountId])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit trail — who did it, when, old value, new value.
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id            String    @id @default(cuid())
  brokerId      String?
  broker        Broker?   @relation(fields: [brokerId], references: [id])
  actorAdminId  String?
  actorAdmin    AdminUser? @relation("AuditLogActor", fields: [actorAdminId], references: [id])
  action        String // "BALANCE_ADJUSTMENT" | "LEVERAGE_CHANGE" | "KYC_APPROVAL" | "ADMIN_PERMISSION_CHANGE" | "MANUAL_POSITION_CLOSE" | ...
  entityType    String // "Account" | "Position" | "AdminUser" | ...
  entityId      String
  oldValue      Json?
  newValue      Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([brokerId])
  @@index([entityType, entityId])
}

// In-app only (no email/SMS infra exists anywhere in this app) --
// broker-scoped, shared read state (any staff member marking one read
// marks it for the whole team, same "one dealing desk" mental model
// the rest of Manager already assumes). See lib/notifications.ts.
model Notification {
  id         String    @id @default(cuid())
  brokerId   String
  broker     Broker    @relation(fields: [brokerId], references: [id])
  type       String // "NEW_LEAD" | "KYC_SUBMITTED" | "FUNDS_REQUEST" | "DEALING_ORDER_PENDING"
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([brokerId])
  @@index([brokerId, readAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Liquidity -- pre-integration record-keeping only. No real LP FIX/API
// connection exists anywhere in this app (blocked on an actual LP
// relationship -- see docs/architecture.md's Phase 5 status). `status` is
// always admin-set, never auto-detected, since nothing can actually
// detect a live connection yet. Deliberately not a credentials vault --
// no API-key/secret field; that's a real security feature (encryption at
// rest, access control) out of scope here, and a plain editable text
// field would be worse than not having it.
// ─────────────────────────────────────────────────────────────────────────

enum LpStatus {
  PROSPECTIVE
  NEGOTIATING
  CONTRACTED
  CONNECTED
}

model LiquidityProvider {
  id           String   @id @default(cuid())
  brokerId     String
  broker       Broker   @relation(fields: [brokerId], references: [id])
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  protocol     String? // free text, e.g. "FIX 4.4", "REST API" -- no fixed taxonomy this early
  status       LpStatus @default(PROSPECTIVE)
  notes        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  routingRules LpRoutingRule[]

  @@index([brokerId])
}

// Intended routing, not live routing -- no execution path reads this yet
// (there is no real LP connection to route to). Recorded now so the
// broker's plan exists before the real integration lands.
model LpRoutingRule {
  id                  String            @id @default(cuid())
  brokerId            String
  broker              Broker            @relation(fields: [brokerId], references: [id])
  liquidityProviderId String
  liquidityProvider   LiquidityProvider @relation(fields: [liquidityProviderId], references: [id])
  symbolId            String? // null = broker-wide default rule
  symbol              Symbol?           @relation(fields: [symbolId], references: [id])
  priority            Int               @default(1) // 1 = primary, 2 = backup, ...
  notes               String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([brokerId])
  @@index([liquidityProviderId])
}
