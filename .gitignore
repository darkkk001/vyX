# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
services/*/dist/
services/*/.env
# Vite-built desktop shell output -- desktop-tauri/dist/ used to hold
# hand-authored splash/offline HTML (tracked as source); it's now pure
# `vite build` output from webtrader-shell/, rebuilt by `npm run
# build:shell` before every `tauri dev`/`tauri build`, same reasoning as
# node_modules/target/ above.
desktop-tauri/dist/
manager-tauri/dist/
admin-tauri/dist/
*-tauri/*-shell/dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# rust (engine/, desktop-tauri/)
/engine/target/
**/target/
Cargo.lock

# tauri -- auto-regenerated by the build from tauri.conf.json/capabilities/,
# same "don't commit build output" reasoning as target/ above.
desktop-tauri/src-tauri/gen/
manager-tauri/src-tauri/gen/
admin-tauri/src-tauri/gen/

# tauri updater signing key -- NEVER commit this. Anyone with this file
# can sign an "update" the app will trust. Public key lives in
# tauri.conf.json (that's meant to be committed); this is the private
# half. See docs/deployment.md's desktop-updates section.
desktop-tauri/src-tauri/.updater-keys/
manager-tauri/src-tauri/.updater-keys/
admin-tauri/src-tauri/.updater-keys/

# engine/scripts/staging-up.sh's runtime state -- PID files, process
# logs, and the parallel-run.jsonl results log, all machine/run-specific.
engine/scripts/.staging/

# typescript
*.tsbuildinfo
next-env.d.ts

# Per-broker NSIS installer wizard banners -- rebrand.js generates these
# fresh from that broker's own logo (generate-nsis-banners.cjs + a
# PowerShell PNG->BMP conversion) every time it runs; no generic default
# is tracked the way icon.ico is, so these are pure build output.
*-tauri/src-tauri/icons/nsis-*.bmp
*-tauri/src-tauri/icons/nsis-*.png
